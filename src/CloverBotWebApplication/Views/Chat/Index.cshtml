@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Chatbot.css" asp-append-version="true" />
}

    <div class="chatbot-container">
        <!-- Animated Chatbot Icon Section -->
        <div class="chatbot-icon-section">
            <div class="chatbot-icon-wrapper">
                <div class="ring ring-1"></div>
                <div class="ring ring-2"></div>
                <div class="ring ring-3"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="chatbot-icon">🤖</div>
            </div>
        </div>

        <!-- Chat Interface Section -->
        <div class="chat-interface">
            <div class="chat-header">
                <h2>Clover AI Assistant</h2>
                <p>Ask me anything! I'm here to help you 24/7</p>
            </div>

            <div class="chat-messages" id="chatMessages">
                <div class="message bot">
                    Hello! I'm Clover AI, your intelligent assistant. How can I help you today?
                </div>
            </div>

            <div class="typing-indicator" id="typingIndicator">
                <div class="typing-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>

            <div class="chat-input-area">
                <input type="text"
                       class="chat-input"
                       id="chatInput"
                       placeholder="Type your question here..."
                       autocomplete="off">
                <button class="send-button" id="sendButton">Send</button>
            </div>
        </div>
    </div>

<!-- Back to Home Link -->
<div class="back-home-link" style="text-align:center; margin-bottom:20px;">
    <a href="@Url.Action("Index", "Home")"
       style="color: ghostwhite; font-weight: 600; font-size: 1.125rem; text-decoration: none;"
       onmouseover="this.style.color='#e0e0e0'"
       onmouseout="this.style.color='ghostwhite'">
        ← Back to Home
    </a>
</div>

@{
    bool showFooter = false;
}

@if (showFooter)
{
    <footer class="bg-white/30 backdrop-blur-lg py-6">
        <div class="container mx-auto px-4 text-center text-gray-600">
            © @DateTime.Now.Year AI Companion App By Diana Mudau. All rights reserved.
        </div>
    </footer>
}

<!-- Scripts Section -->
@section Scripts {
    <!-- Add in the <head> or before your script -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/Chatbot.js" asp-append-version="true"></script>
}
